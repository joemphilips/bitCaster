---
// Who talks to whom in bitCaster, with one short label on every arrow.
// Text is real markup, not an image, so both languages and both themes share one component.
// The six steps light up in order, and a dot runs along each arrow, to show the flow.
interface Props {
  lang?: 'en' | 'ja'
}

const { lang = 'en' } = Astro.props

const copy = {
  en: {
    label: 'How the parts of bitCaster talk to each other',
    app: {
      name: 'bitCaster app or CLI',
      trait: 'Open source',
      text: 'One app, two roles. Anyone can take either one.',
    },
    creator: {
      name: 'Market creator = Oracle',
      text: 'Asks the question, and later signs the answer.',
    },
    trader: {
      name: 'Trader',
      text: 'Buys and sells shares.',
    },
    mint: {
      name: 'Cashu mint',
      trait: 'Open source',
      text: 'Issues the tokens, holds the bitcoin, and pays out.',
    },
    engine: {
      name: 'Matching engine',
      trait: 'Closed source · public API',
      text: 'Keeps the order book and matches buyers with sellers.',
    },
    create: 'Creator registers a market',
    sync: 'Share market info',
    order: 'Traders place orders',
    settle: 'Settle matched trades',
    result: 'Oracle signs the result',
    payout: 'Winners cash out with the signed result',
    cash: 'Deposit · withdraw',
    caption:
      'Steps 1 to 6 follow one market from creation to payout. Deposits and withdrawals can happen at any time.',
  },
  ja: {
    label: 'bitCaster の各部品がどうやり取りするか',
    app: {
      name: 'bitCaster アプリまたは CLI',
      trait: 'オープンソース',
      text: '同じアプリで、誰でもどちらの役割にもなれます。',
    },
    creator: {
      name: 'マーケット作成者 = オラクル',
      text: '質問を立て、後からその答えに署名します。',
    },
    trader: {
      name: 'トレーダー',
      text: 'シェアを売買します。',
    },
    mint: {
      name: 'Cashu ミント',
      trait: 'オープンソース',
      text: 'トークンを発行し、bitcoin を保管し、払い出します。',
    },
    engine: {
      name: 'マッチングエンジン',
      trait: 'クローズドソース · API は公開',
      text: '注文板を管理し、買い手と売り手をマッチングします。',
    },
    create: '作成者がマーケットを登録',
    sync: 'マーケット情報を同期',
    order: 'トレーダーが注文を出す',
    settle: '約定した取引を決済',
    result: 'オラクルが結果に署名',
    payout: '署名された結果を添えて換金',
    cash: '入金 · 出金',
    caption:
      '1 から 6 は、1 つのマーケットの作成から払い出しまでの順番です。入金と出金はいつでもできます。',
  },
}[lang]
---

<figure class="arch not-content" aria-label={copy.label}>
  <div class="grid">
    <div class="node app">
      <p class="name">{copy.app.name}</p>
      <p class="trait">{copy.app.trait}</p>
      <p class="text">{copy.app.text}</p>
      <div class="roles">
        <div class="role">
          <p class="name">{copy.creator.name}</p>
          <p class="text">{copy.creator.text}</p>
        </div>
        <div class="role">
          <p class="name">{copy.trader.name}</p>
          <p class="text">{copy.trader.text}</p>
        </div>
      </div>
    </div>

    <div class="wire v both app-mint">
      <span class="line" aria-hidden="true">
        <span class="dot down" style="--i: 1"></span>
        <span class="dot down" style="--i: 6"></span>
      </span>
      <ul>
        <li class="step" style="--i: 1"><span class="n">1</span>{copy.create}</li>
        <li class="step" style="--i: 6"><span class="n">6</span>{copy.payout}</li>
        <li>{copy.cash}</li>
      </ul>
    </div>

    <div class="wire v down app-engine">
      <span class="line" aria-hidden="true">
        <span class="dot down" style="--i: 3"></span>
        <span class="dot down" style="--i: 5"></span>
      </span>
      <ul>
        <li class="step" style="--i: 3"><span class="n">3</span>{copy.order}</li>
        <li class="step" style="--i: 5"><span class="n">5</span>{copy.result}</li>
      </ul>
    </div>

    <div class="node mint">
      <p class="name">{copy.mint.name}</p>
      <p class="trait">{copy.mint.trait}</p>
      <p class="text">{copy.mint.text}</p>
    </div>

    <div class="wire h mint-engine">
      <p class="step" style="--i: 2"><span class="n">2</span>{copy.sync}</p>
      <span class="line both" aria-hidden="true">
        <span class="dot right" style="--i: 2"></span>
      </span>
      <span class="line left" aria-hidden="true">
        <span class="dot left" style="--i: 4"></span>
      </span>
      <p class="step" style="--i: 4"><span class="n">4</span>{copy.settle}</p>
    </div>

    <div class="node engine">
      <p class="name">{copy.engine.name}</p>
      <p class="trait">{copy.engine.trait}</p>
      <p class="text">{copy.engine.text}</p>
    </div>
  </div>
  <figcaption>{copy.caption}</figcaption>
</figure>

<style>
  .arch {
    --wire: var(--sl-color-gray-3);
    /* One pass through the six steps, then a short rest. */
    --cycle: 15s;
    --slot: 2.2s;
    margin-block: 2rem;
  }

  p,
  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .grid {
    /* Keep Japanese phrases together when a label wraps. */
    word-break: auto-phrase;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(5.75rem, 0.62fr) minmax(0, 1fr);
    grid-template-areas:
      'app  app app'
      'am   .   ae'
      'mint me  engine';
  }

  .app {
    grid-area: app;
  }
  .app-mint {
    grid-area: am;
  }
  .app-engine {
    grid-area: ae;
  }
  .mint {
    grid-area: mint;
  }
  .mint-engine {
    grid-area: me;
  }
  .engine {
    grid-area: engine;
  }

  .node {
    padding: 0.875rem 1rem;
    border: 1px solid var(--bc-rule-strong);
    border-radius: 0.5rem;
    background: var(--bc-surface);
  }

  /* The app is where the people are. It is tinted. The two services stay neutral. */
  .node.app {
    border-color: var(--sl-color-accent);
    background: color-mix(in srgb, var(--sl-color-accent) 9%, var(--bc-surface));
  }

  .name {
    color: var(--sl-color-white);
    font-size: var(--sl-text-base);
    font-weight: 700;
    line-height: 1.3;
  }

  .trait {
    margin-top: 0.125rem;
    color: var(--bc-amber);
    font-size: var(--sl-text-xs);
    line-height: 1.4;
  }

  .text {
    margin-top: 0.375rem;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
    line-height: 1.5;
  }

  .roles {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.625rem;
    margin-top: 0.75rem;
  }

  .role {
    padding: 0.625rem 0.75rem;
    border: 1px dashed color-mix(in srgb, var(--sl-color-accent) 60%, transparent);
    border-radius: 0.375rem;
  }

  .role .name {
    font-size: var(--sl-text-sm);
  }

  .role .text {
    margin-top: 0.125rem;
    font-size: var(--sl-text-xs);
  }

  .wire {
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-xs);
    line-height: 1.35;
  }

  .line {
    position: relative;
    display: block;
    background: var(--wire);
  }

  .line::before,
  .line::after {
    position: absolute;
    width: 0;
    height: 0;
    border: 0.3125rem solid transparent;
  }

  /* Vertical wires: a line near the left edge of the node, labels beside it. */
  .wire.v {
    display: grid;
    grid-template-columns: 0.625rem minmax(0, 1fr);
    column-gap: 0.625rem;
    min-height: 4.5rem;
    padding-left: 1.25rem;
  }

  .wire.v .line {
    justify-self: center;
    width: 0.125rem;
    margin-block: 0.25rem;
  }

  .wire.v ul {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    justify-content: center;
    padding-block: 0.75rem;
  }

  .wire.v li {
    display: flex;
    gap: 0.375rem;
    align-items: baseline;
  }

  .wire.v.down .line::after,
  .wire.v.both .line::after {
    content: '';
    bottom: -0.25rem;
    left: 50%;
    border-top-color: var(--wire);
    border-bottom-width: 0;
    transform: translateX(-50%);
  }

  .wire.v.both .line::before {
    content: '';
    top: -0.25rem;
    left: 50%;
    border-top-width: 0;
    border-bottom-color: var(--wire);
    transform: translateX(-50%);
  }

  /* The horizontal wire: one label above its line, one below. */
  .wire.h {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    justify-content: center;
    padding-inline: 0.25rem;
    text-align: center;
  }

  .wire.h .line {
    height: 0.125rem;
  }

  .wire.h .line.both {
    margin-bottom: 0.25rem;
  }

  .wire.h .line.both::after {
    content: '';
    top: 50%;
    right: -0.25rem;
    border-right-width: 0;
    border-left-color: var(--wire);
    transform: translateY(-50%);
  }

  .wire.h .line::before {
    content: '';
    top: 50%;
    left: -0.25rem;
    border-left-width: 0;
    border-right-color: var(--wire);
    transform: translateY(-50%);
  }

  .n {
    display: inline-grid;
    flex: none;
    place-items: center;
    width: 1.25rem;
    height: 1.25rem;
    margin-right: 0.3125rem;
    border-radius: 999px;
    background: var(--sl-color-accent);
    color: var(--sl-color-black);
    font-family: var(--sl-font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    line-height: 1;
    vertical-align: 0.0625rem;
  }

  .wire.v .n {
    margin-right: 0;
    transform: translateY(0.0625rem);
  }

  /* The flow. Step i owns one slot of the cycle: its label lights up and a dot runs along its arrow. */
  .step,
  .step .n,
  .dot {
    animation-duration: var(--cycle);
    animation-timing-function: linear;
    animation-iteration-count: infinite;
    animation-delay: calc((var(--i) - 1) * var(--slot));
    animation-fill-mode: backwards;
  }

  .step {
    animation-name: arch-label;
  }

  .step .n {
    animation-name: arch-badge;
  }

  .dot {
    position: absolute;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: var(--bc-amber);
    opacity: 0;
    translate: -50% -50%;
  }

  .dot.down {
    left: 50%;
  }

  .dot.right,
  .dot.left {
    top: 50%;
  }

  .dot.down {
    animation-name: arch-down;
  }
  .dot.right {
    animation-name: arch-right;
  }
  .dot.left {
    animation-name: arch-left;
  }

  @keyframes arch-label {
    0%,
    14.6%,
    100% {
      color: var(--sl-color-gray-2);
    }
    1.5%,
    13% {
      color: var(--sl-color-white);
    }
  }

  @keyframes arch-badge {
    0%,
    14.6%,
    100% {
      background: var(--sl-color-accent);
    }
    1.5%,
    13% {
      background: var(--bc-amber);
    }
  }

  @keyframes arch-down {
    0% {
      top: 0;
      opacity: 0;
    }
    1.5% {
      top: 0;
      opacity: 1;
    }
    12% {
      top: 100%;
      opacity: 1;
    }
    14.6%,
    100% {
      top: 100%;
      opacity: 0;
    }
  }

  @keyframes arch-right {
    0% {
      left: 0;
      opacity: 0;
    }
    1.5% {
      left: 0;
      opacity: 1;
    }
    12% {
      left: 100%;
      opacity: 1;
    }
    14.6%,
    100% {
      left: 100%;
      opacity: 0;
    }
  }

  @keyframes arch-left {
    0% {
      left: 100%;
      opacity: 0;
    }
    1.5% {
      left: 100%;
      opacity: 1;
    }
    12% {
      left: 0;
      opacity: 1;
    }
    14.6%,
    100% {
      left: 0;
      opacity: 0;
    }
  }

  /* Without motion the diagram is complete as it stands: every arrow keeps its number and label. */
  @media (prefers-reduced-motion: reduce) {
    .step,
    .step .n,
    .dot {
      animation: none;
    }
  }

  figcaption {
    margin-top: 0.75rem;
    color: var(--bc-muted);
    font-size: var(--sl-text-sm);
    line-height: 1.6;
    text-align: center;
  }

  @media (max-width: 34rem) {
    .node {
      padding: 0.625rem 0.75rem;
    }

    .name {
      font-size: var(--sl-text-sm);
    }

    .text {
      font-size: var(--sl-text-xs);
    }

    .wire.v {
      padding-left: 0.5rem;
    }
  }
</style>
