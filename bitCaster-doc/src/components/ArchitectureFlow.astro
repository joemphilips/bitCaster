---
// Who talks to whom in bitCaster, with one short label on every arrow.
// Text is real markup, not an image, so both languages and both themes share one component.
interface Props {
  lang?: 'en' | 'ja'
}

const { lang = 'en' } = Astro.props

const copy = {
  en: {
    label: 'How the parts of bitCaster talk to each other',
    creator: {
      name: 'Market creator = Oracle',
      text: 'Asks the question, and later signs the answer.',
    },
    mint: {
      name: 'Cashu mint',
      trait: 'Open source',
      text: 'Issues the tokens, holds the bitcoin, and pays out.',
    },
    engine: {
      name: 'Matching engine',
      trait: 'Closed source · public API',
      text: 'Keeps the order book and matches buyers with sellers.',
    },
    traders: {
      name: 'Traders',
      trait: 'bitCaster app or CLI · open source',
      text: 'Each trader keeps a wallet on their own device.',
    },
    create: 'Creates a market',
    sync: 'Share market info',
    order: 'Place orders',
    settle: 'Settle matched trades',
    result: 'Signs the result',
    payout: 'Pays out winning shares',
    cash: 'Deposit · withdraw',
    caption:
      'Steps 1 to 6 follow one market from creation to payout. Deposits and withdrawals can happen at any time.',
  },
  ja: {
    label: 'bitCaster の各部品がどうやり取りするか',
    creator: {
      name: 'マーケット作成者 = オラクル',
      text: '質問を立て、後からその答えに署名します。',
    },
    mint: {
      name: 'Cashu ミント',
      trait: 'オープンソース',
      text: 'トークンを発行し、bitcoin を保管し、払い出します。',
    },
    engine: {
      name: 'マッチングエンジン',
      trait: 'クローズドソース · API は公開',
      text: '注文板を管理し、買い手と売り手をマッチングします。',
    },
    traders: {
      name: 'トレーダー',
      trait: 'bitCaster アプリまたは CLI · オープンソース',
      text: 'ウォレットは、それぞれのトレーダー自身の端末にあります。',
    },
    create: 'マーケットを作成',
    sync: 'マーケット情報を同期',
    order: '注文を出す',
    settle: '約定した取引を決済',
    result: '結果に署名',
    payout: '当たったシェアに払い出し',
    cash: '入金 · 出金',
    caption:
      '1 から 6 は、1 つのマーケットの作成から払い出しまでの順番です。入金と出金はいつでもできます。',
  },
}[lang]
---

<figure class="arch not-content" aria-label={copy.label}>
  <div class="grid">
    <div class="node person creator">
      <p class="name">{copy.creator.name}</p>
      <p class="text">{copy.creator.text}</p>
    </div>

    <div class="wire v down creator-mint">
      <span class="line" aria-hidden="true"></span>
      <ul>
        <li><span class="n">1</span>{copy.create}</li>
        <li><span class="n">5</span>{copy.result}</li>
      </ul>
    </div>

    <div class="node mint">
      <p class="name">{copy.mint.name}</p>
      <p class="trait">{copy.mint.trait}</p>
      <p class="text">{copy.mint.text}</p>
    </div>

    <div class="wire h mint-engine">
      <p><span class="n">2</span>{copy.sync}</p>
      <span class="line both" aria-hidden="true"></span>
      <span class="line left" aria-hidden="true"></span>
      <p><span class="n">4</span>{copy.settle}</p>
    </div>

    <div class="node engine">
      <p class="name">{copy.engine.name}</p>
      <p class="trait">{copy.engine.trait}</p>
      <p class="text">{copy.engine.text}</p>
    </div>

    <div class="wire v both mint-traders">
      <span class="line" aria-hidden="true"></span>
      <ul>
        <li>{copy.cash}</li>
        <li><span class="n">6</span>{copy.payout}</li>
      </ul>
    </div>

    <div class="wire v up traders-engine">
      <span class="line" aria-hidden="true"></span>
      <ul>
        <li><span class="n">3</span>{copy.order}</li>
      </ul>
    </div>

    <div class="node person traders">
      <p class="name">{copy.traders.name}</p>
      <p class="trait">{copy.traders.trait}</p>
      <p class="text">{copy.traders.text}</p>
    </div>
  </div>
  <figcaption>{copy.caption}</figcaption>
</figure>

<style>
  .arch {
    --wire: var(--sl-color-gray-3);
    margin-block: 2rem;
  }

  p,
  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .grid {
    /* Keep Japanese phrases together when a label wraps. */
    word-break: auto-phrase;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(5.75rem, 0.62fr) minmax(0, 1fr);
    grid-template-areas:
      'creator .       .'
      'cm      .       .'
      'mint    me      engine'
      'mt      .       te'
      'traders traders traders';
  }

  .creator {
    grid-area: creator;
  }
  .creator-mint {
    grid-area: cm;
  }
  .mint {
    grid-area: mint;
  }
  .mint-engine {
    grid-area: me;
  }
  .engine {
    grid-area: engine;
  }
  .mint-traders {
    grid-area: mt;
  }
  .traders-engine {
    grid-area: te;
  }
  .traders {
    grid-area: traders;
  }

  .node {
    padding: 0.875rem 1rem;
    border: 1px solid var(--bc-rule-strong);
    border-radius: 0.5rem;
    background: var(--bc-surface);
  }

  /* People are tinted. The two services stay neutral. */
  .node.person {
    border-color: var(--sl-color-accent);
    background: color-mix(in srgb, var(--sl-color-accent) 9%, var(--bc-surface));
  }

  .name {
    color: var(--sl-color-white);
    font-size: var(--sl-text-base);
    font-weight: 700;
    line-height: 1.3;
  }

  .trait {
    margin-top: 0.125rem;
    color: var(--bc-amber);
    font-size: var(--sl-text-xs);
    line-height: 1.4;
  }

  .text {
    margin-top: 0.375rem;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
    line-height: 1.5;
  }

  .wire {
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-xs);
    line-height: 1.35;
  }

  .line {
    position: relative;
    display: block;
    background: var(--wire);
  }

  .line::before,
  .line::after {
    position: absolute;
    width: 0;
    height: 0;
    border: 0.3125rem solid transparent;
  }

  /* Vertical wires: a line near the left edge of the node, labels beside it. */
  .wire.v {
    display: grid;
    grid-template-columns: 0.625rem minmax(0, 1fr);
    column-gap: 0.625rem;
    min-height: 4.5rem;
    padding-left: 1.25rem;
  }

  .wire.v .line {
    justify-self: center;
    width: 0.125rem;
    margin-block: 0.25rem;
  }

  .wire.v ul {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    justify-content: center;
    padding-block: 0.75rem;
  }

  .wire.v li {
    display: flex;
    gap: 0.375rem;
    align-items: baseline;
  }

  .wire.v.down .line::after,
  .wire.v.both .line::after {
    content: '';
    bottom: -0.25rem;
    left: 50%;
    border-top-color: var(--wire);
    border-bottom-width: 0;
    transform: translateX(-50%);
  }

  .wire.v.up .line::before,
  .wire.v.both .line::before {
    content: '';
    top: -0.25rem;
    left: 50%;
    border-top-width: 0;
    border-bottom-color: var(--wire);
    transform: translateX(-50%);
  }

  /* The horizontal wire: one label above its line, one below. */
  .wire.h {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    justify-content: center;
    padding-inline: 0.25rem;
    text-align: center;
  }

  .wire.h .line {
    height: 0.125rem;
  }

  .wire.h .line.both {
    margin-bottom: 0.25rem;
  }

  .wire.h .line.both::after {
    content: '';
    top: 50%;
    right: -0.25rem;
    border-right-width: 0;
    border-left-color: var(--wire);
    transform: translateY(-50%);
  }

  .wire.h .line::before {
    content: '';
    top: 50%;
    left: -0.25rem;
    border-left-width: 0;
    border-right-color: var(--wire);
    transform: translateY(-50%);
  }

  .n {
    display: inline-grid;
    flex: none;
    place-items: center;
    width: 1.25rem;
    height: 1.25rem;
    margin-right: 0.3125rem;
    border-radius: 999px;
    background: var(--sl-color-accent);
    color: var(--sl-color-black);
    font-family: var(--sl-font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    line-height: 1;
    vertical-align: 0.0625rem;
  }

  .wire.v .n {
    margin-right: 0;
    transform: translateY(0.0625rem);
  }

  figcaption {
    margin-top: 0.75rem;
    color: var(--bc-muted);
    font-size: var(--sl-text-sm);
    line-height: 1.6;
    text-align: center;
  }

  @media (max-width: 34rem) {
    .node {
      padding: 0.625rem 0.75rem;
    }

    .name {
      font-size: var(--sl-text-sm);
    }

    .text {
      font-size: var(--sl-text-xs);
    }

    .wire.v {
      padding-left: 0.5rem;
    }
  }
</style>
