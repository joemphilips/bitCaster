---
// The four layers of money that a bitCaster position rests on, drawn as a stack.
// Text is real markup, not an image, so both languages and both themes share one component.
interface Props {
  lang?: 'en' | 'ja'
}

const { lang = 'en' } = Astro.props

const copy = {
  en: {
    label: 'The four layers of tokens that bitCaster uses',
    inside: 'Inside bitCaster',
    outside: 'The Bitcoin network',
    layer: 'Layer',
    layers: [
      {
        n: 4,
        name: 'Conditional tokens',
        trait: 'Your shares',
        text: 'Your position in a market. A share pays out only if its outcome wins.',
      },
      {
        n: 3,
        name: 'Ecash',
        trait: 'Fast · private · relies on the mint',
        text: 'Your wallet balance. Instant and private. The mint holds the bitcoin behind it.',
      },
      {
        n: 2,
        name: 'Lightning',
        trait: 'Fast · trustless · online only',
        text: 'Bitcoin payments in seconds for tiny fees. Nobody new to trust, but you have to stay online.',
      },
      {
        n: 1,
        name: 'Bitcoin',
        trait: 'Trustless · slow',
        text: 'The base money. Final and censorship-resistant, but too slow and costly to trade on.',
      },
    ],
    bridges: ['buy · sell · claim payout', 'deposit · withdraw', 'open · close a channel'],
    caption:
      'Value moves up a layer when you want to trade, and back down when you want to hold. bitCaster adds the top two layers.',
  },
  ja: {
    label: 'bitCaster が使う 4 層のトークン',
    inside: 'bitCaster の内側',
    outside: 'Bitcoin ネットワーク',
    layer: 'レイヤー',
    layers: [
      {
        n: 4,
        name: '条件付きトークン',
        trait: 'あなたのシェア',
        text: 'マーケットでのポジションです。対応する結果が当たったときだけ払い出されます。',
      },
      {
        n: 3,
        name: 'Ecash',
        trait: '高速 · プライベート · ミントに依存',
        text: 'ウォレットの残高です。即時に動かせて、プライベートです。裏付けの bitcoin はミントが保管します。',
      },
      {
        n: 2,
        name: 'Lightning',
        trait: '高速 · トラストレス · オンライン必須',
        text: '数秒で届く、手数料のごく小さい bitcoin 送金です。新たに信頼する相手は増えませんが、オンラインでいる必要があります。',
      },
      {
        n: 1,
        name: 'Bitcoin',
        trait: 'トラストレス · 低速',
        text: '土台となるお金です。確定的で検閲に強い一方、取引に使うには遅く、手数料もかかります。',
      },
    ],
    bridges: ['購入 · 売却 · 報酬受取', '入金 · 出金', 'チャネルの開設 · 閉鎖'],
    caption:
      '取引したいときは価値を上の層へ、保有したいときは下の層へ動かします。bitCaster が加えるのは上の 2 層です。',
  },
}[lang]

const [l4, l3, l2, l1] = copy.layers
const [tradeBridge, lightningBridge, channelBridge] = copy.bridges
---

<figure class="token-layers not-content" aria-label={copy.label}>
  <div class="zone inside">
    <p class="zone-label">{copy.inside}</p>
    <div class="layer">
      <p class="tag">{copy.layer} {l4.n}</p>
      <p class="name">{l4.name}</p>
      <p class="trait">{l4.trait}</p>
      <p class="text">{l4.text}</p>
    </div>
    <p class="bridge"><span aria-hidden="true">↑↓</span>{tradeBridge}</p>
    <div class="layer">
      <p class="tag">{copy.layer} {l3.n}</p>
      <p class="name">{l3.name}</p>
      <p class="trait">{l3.trait}</p>
      <p class="text">{l3.text}</p>
    </div>
  </div>
  <p class="bridge between"><span aria-hidden="true">↑↓</span>{lightningBridge}</p>
  <div class="zone outside">
    <p class="zone-label">{copy.outside}</p>
    <div class="layer">
      <p class="tag">{copy.layer} {l2.n}</p>
      <p class="name">{l2.name}</p>
      <p class="trait">{l2.trait}</p>
      <p class="text">{l2.text}</p>
    </div>
    <p class="bridge"><span aria-hidden="true">↑↓</span>{channelBridge}</p>
    <div class="layer">
      <p class="tag">{copy.layer} {l1.n}</p>
      <p class="name">{l1.name}</p>
      <p class="trait">{l1.trait}</p>
      <p class="text">{l1.text}</p>
    </div>
  </div>
  <figcaption>{copy.caption}</figcaption>
</figure>

<style>
  .token-layers {
    margin-block: 2rem;
  }

  p {
    margin: 0;
  }

  .zone {
    padding: 0.75rem;
    border: 1px solid var(--bc-rule-strong);
    border-radius: 0.75rem;
  }

  .zone.inside {
    border-color: var(--sl-color-accent);
    background: color-mix(in srgb, var(--sl-color-accent) 7%, transparent);
  }

  .zone-label {
    margin-bottom: 0.625rem;
    color: var(--bc-muted);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .inside .zone-label {
    color: var(--sl-color-accent);
  }

  .layer {
    display: grid;
    grid-template-columns: minmax(0, 14rem) minmax(0, 1fr);
    column-gap: 1.5rem;
    align-items: start;
    padding: 0.875rem 1rem;
    border: 1px solid var(--bc-rule);
    border-radius: 0.5rem;
    background: var(--bc-surface);
  }

  .tag,
  .name,
  .trait {
    grid-column: 1;
  }

  .tag {
    color: var(--bc-muted);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
  }

  .name {
    color: var(--sl-color-white);
    font-size: var(--sl-text-xl);
    font-weight: 700;
    line-height: 1.25;
  }

  .trait {
    margin-top: 0.125rem;
    color: var(--bc-amber);
    font-size: var(--sl-text-xs);
    line-height: 1.4;
  }

  .text {
    grid-column: 2;
    grid-row: 1 / span 3;
    align-self: center;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
    line-height: 1.6;
  }

  .bridge {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    justify-content: center;
    padding-block: 0.375rem;
    color: var(--bc-muted);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
  }

  .bridge span {
    color: var(--sl-color-white);
    font-size: var(--sl-text-sm);
    letter-spacing: -0.15em;
  }

  .bridge.between {
    padding-block: 0.5rem;
  }

  figcaption {
    margin-top: 0.75rem;
    color: var(--bc-muted);
    font-size: var(--sl-text-sm);
    line-height: 1.6;
    text-align: center;
  }

  @media (max-width: 34rem) {
    .layer {
      grid-template-columns: minmax(0, 1fr);
    }

    .text {
      grid-column: 1;
      grid-row: auto;
      margin-top: 0.5rem;
    }
  }
</style>
