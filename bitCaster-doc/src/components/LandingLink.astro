---
interface Props {
  href: string
  title: string
  description: string
  primary?: boolean
}

const { href, title, description, primary = false } = Astro.props
---

<a class:list={['landing-link', { primary }]} href={href}>
  <span class="text">
    <span class="title">{title}</span>
    <span class="description">{description}</span>
  </span>
  <svg
    aria-hidden="true"
    width="20"
    height="20"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg
  >
</a>

<style>
  .landing-link {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    min-height: 4.5rem;
    padding: 0.75rem 1.25rem;
    border: 1px solid var(--bc-rule-strong);
    border-radius: 0.75rem;
    color: var(--sl-color-white);
    text-decoration: none;
  }

  .landing-link:hover {
    border-color: var(--sl-color-accent);
  }

  .landing-link.primary {
    border-color: var(--bc-primary-bg);
    background: var(--bc-primary-bg);
    color: #ffffff;
  }

  .landing-link.primary:hover {
    border-color: var(--bc-primary-bg-hover);
    background: var(--bc-primary-bg-hover);
  }

  .text {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    gap: 0.25rem;
  }

  .title {
    font-size: var(--sl-text-lg);
    font-weight: 700;
    line-height: 1.3;
  }

  .description {
    color: var(--bc-muted);
    font-size: var(--sl-text-sm);
    line-height: 1.45;
  }

  .primary .description {
    color: #dbeafe;
  }

  svg {
    flex: none;
  }
</style>
