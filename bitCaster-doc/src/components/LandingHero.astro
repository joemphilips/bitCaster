---
// Starlight `Hero` override. A page that sets `heroReflection` gets the centered landing hero.
// Other hero pages keep Starlight's default hero, so their image and actions still render.
import DefaultHero from '@astrojs/starlight/components/Hero.astro'

const { data } = Astro.locals.starlightRoute.entry
const { heroReflection: reflection } = data as {
  heroReflection?: string
}
const { title = data.title, tagline } = data.hero ?? {}
---

{
  reflection === undefined ? (
    <DefaultHero />
  ) : (
    <div class="landing-hero">
      {/* Starlight's skip link targets the page-title id `_top`. */}
      <h1 id="_top" data-page-title>
        <span class="motto" set:html={title} />
        {reflection && (
          <>
            <span class="waterline" aria-hidden="true" />
            {/* The second motto is the first one seen in water: mirrored, rippling, fading with depth. */}
            <span class="water">
              <span class="reflection">{reflection}</span>
            </span>
          </>
        )}
      </h1>
      {reflection && (
        <svg class="defs" aria-hidden="true" focusable="false">
          {/* Rows of the text slide sideways in slow bands. Nothing moves up or down, so the letters stay readable. */}
          <filter id="bc-ripple" x="-5%" y="-10%" width="110%" height="120%">
            <feTurbulence type="fractalNoise" baseFrequency="0.0015 0.032" numOctaves="1" seed="7" result="waves">
              <animate
                attributeName="baseFrequency"
                dur="16s"
                values="0.0015 0.032; 0.0015 0.046; 0.0015 0.032"
                repeatCount="indefinite"
              />
            </feTurbulence>
            <feDisplacementMap in="SourceGraphic" in2="waves" scale="7" xChannelSelector="R" yChannelSelector="A" />
            <feGaussianBlur stdDeviation="0.35" />
          </filter>
          <filter id="bc-ripple-still" x="-5%" y="-10%" width="110%" height="120%">
            <feTurbulence type="fractalNoise" baseFrequency="0.0015 0.032" numOctaves="1" seed="7" result="waves" />
            <feDisplacementMap in="SourceGraphic" in2="waves" scale="7" xChannelSelector="R" yChannelSelector="A" />
            <feGaussianBlur stdDeviation="0.35" />
          </filter>
        </svg>
      )}
      {tagline && <p class="tagline" set:html={tagline} />}
    </div>
  )
}

<style>
  .landing-hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.75rem;
    padding-block: clamp(2.5rem, 7vw, 6.5rem) 1rem;
    text-align: center;
  }

  h1 {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin: 0;
    max-width: 100%;
    color: var(--sl-color-white);
    font-size: clamp(2.25rem, 6.2vw, 5rem);
    font-weight: 800;
    line-height: 1.04;
    letter-spacing: -0.04em;
  }

  /* A Japanese line has no spaces. This size keeps each line whole on a phone. */
  h1:lang(ja) {
    font-size: clamp(1.75rem, 5.4vw, 4.5rem);
  }

  .motto,
  .reflection {
    display: block;
    text-wrap: balance;
    /* Keep Japanese phrases together when the title wraps. */
    word-break: auto-phrase;
  }

  /* The surface of the water: a hairline that fades out at both ends. */
  .waterline {
    width: min(100%, 13em);
    height: 1px;
    margin-block: 0.14em 0.1em;
    background: linear-gradient(
      to right,
      transparent,
      color-mix(in srgb, var(--bc-amber) 70%, transparent) 22%,
      color-mix(in srgb, var(--bc-amber) 70%, transparent) 78%,
      transparent
    );
  }

  /* A faint glow under the surface gives the reflection something to sit in. */
  .water {
    display: block;
    padding-bottom: 0.12em;
    background: radial-gradient(
      ellipse 60% 90% at 50% 0%,
      color-mix(in srgb, var(--bc-amber) 9%, transparent),
      transparent 75%
    );
    /* The reflection fades with depth. */
    mask-image: linear-gradient(to bottom, #000 15%, rgb(0 0 0 / 0.38));
  }

  .reflection {
    color: var(--bc-amber);
    /* Flipped top to bottom, as a reflection is. Remove the flip to show the motto upright. */
    transform: scaleY(-1);
    filter: url('#bc-ripple');
    transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  /* Pointing at the title turns the reflection the right way up, for anyone who wants to read it plainly. */
  h1:hover .reflection {
    transform: scaleY(1);
  }

  .defs {
    position: absolute;
    width: 0;
    height: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .reflection {
      filter: url('#bc-ripple-still');
      transition: none;
    }
  }

  .tagline {
    margin: 0;
    max-width: 40rem;
    color: var(--bc-muted);
    font-size: clamp(1.0625rem, 2vw, 1.3125rem);
    line-height: 1.6;
    word-break: auto-phrase;
  }
</style>
