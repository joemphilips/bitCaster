---
// Starlight `Hero` override. A page that sets `heroNotice` gets the centered landing hero.
// Other hero pages keep Starlight's default hero, so their image and actions still render.
import DefaultHero from '@astrojs/starlight/components/Hero.astro'

const { data } = Astro.locals.starlightRoute.entry
const notice = (data as { heroNotice?: string }).heroNotice
const { title = data.title, tagline } = data.hero ?? {}
---

{
  notice === undefined ? (
    <DefaultHero />
  ) : (
    <div class="landing-hero">
      <p class="notice">{notice}</p>
      {/* Starlight's skip link targets the page-title id `_top`. */}
      <h1 id="_top" data-page-title set:html={title} />
      {tagline && <p class="tagline" set:html={tagline} />}
    </div>
  )
}

<style>
  .landing-hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.75rem;
    padding-block: clamp(2.5rem, 7vw, 6.5rem) 1rem;
    text-align: center;
  }

  .notice {
    margin: 0;
    padding: 0.375rem 0.875rem;
    border: 1px solid var(--bc-notice-border);
    border-radius: 999px;
    background: var(--bc-notice-bg);
    color: var(--bc-notice-text);
    font-size: var(--sl-text-sm);
    font-weight: 500;
    line-height: 1.4;
  }

  h1 {
    margin: 0;
    max-width: 100%;
    color: var(--sl-color-white);
    font-size: clamp(2.25rem, 6.2vw, 5rem);
    font-weight: 800;
    line-height: 1.04;
    letter-spacing: -0.04em;
    text-wrap: balance;
    /* Keep Japanese phrases together when the title wraps. */
    word-break: auto-phrase;
  }

  /* A Japanese line has no spaces. This size keeps each line whole on a phone. */
  h1:lang(ja) {
    font-size: clamp(1.75rem, 5.4vw, 4.5rem);
  }

  h1 :global(span) {
    color: var(--bc-amber);
  }

  .tagline {
    margin: 0;
    max-width: 40rem;
    color: var(--bc-muted);
    font-size: clamp(1.0625rem, 2vw, 1.3125rem);
    line-height: 1.6;
    word-break: auto-phrase;
  }
</style>
