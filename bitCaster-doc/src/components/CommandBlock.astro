---
// A small label above a fenced code block, which the page passes as the slot.
interface Props {
  label: string
}

const { label } = Astro.props
---

<div class="command-block">
  <p class="label">{label}</p>
  <slot />
</div>

<style>
  .command-block {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .label {
    margin: 0;
    color: var(--bc-amber);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .command-block :global(.expressive-code) {
    margin: 0;
  }
</style>
