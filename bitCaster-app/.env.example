# Cashu mint URL (e.g. your CDK mintd instance)
VITE_MINT_URL=http://localhost:8085

# Optional: default oracle pubkey (hex) for DLC announcements
VITE_ORACLE_PUBKEY=

# Optional: comma-separated Nostr relay URLs. This list replaces the defaults.
# An empty value disables relays. Omit this setting to use the local development default.
VITE_NOSTR_RELAYS=

# Optional: explicit deployment environment: mainnet or testnet.
# Leave both settings empty for local development. Vite reads them at build time.
VITE_BITCASTER_ENVIRONMENT=

# Optional: approved HTTPS origin of the other environment.
# Use an origin only. Do not include credentials, a path, a query, or a fragment.
# The link stays hidden if either setting is missing or invalid.
VITE_ALTERNATE_ORIGIN=
