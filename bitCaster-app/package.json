{
  "name": "bitcaster",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:stopped": "vite build --config vite.stopped.config.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint:enum-discipline": "bash scripts/check-enum-discipline.sh",
    "lint:identity-ops": "bash scripts/check-identity-ops-boundary.sh",
    "lint:wallet-ops": "bash scripts/check-wallet-ops-boundary.sh",
    "test": "vitest run",
    "test:server": "node --test server-tests/*.node-test.mjs",
    "test:stopped-host:browser": "npm run build && npm run build:stopped && node --test server-tests/stopped-service-worker.browser-test.mjs",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:browser:chart-geometry": "vitest run --config vitest.chart-geometry.config.ts",
    "test:browser:shell": "vitest run --config vitest.shell.config.ts",
    "test:watch": "vitest",
    "generate:api": "openapi-typescript ../BitCaster.MatchingEngine.Contracts/specs/openapi.yaml -o src/generated/api.ts && openapi-typescript ../BitCaster.MatchingEngine.Contracts/specs/openapi.yaml -o ../bitcaster-client-sdk/src/generated/api.ts && prettier --write ../bitcaster-client-sdk/src/generated/api.ts"
  },
  "dependencies": {
    "@cashu/cashu-ts": "file:../cashu-ts",
    "@microsoft/signalr": "^10.0.11",
    "@noble/curves": "^2.4.0",
    "@nostr-dev-kit/ndk": "3.0.3",
    "@nostr-dev-kit/ndk-wallet": "^0.3.17",
    "@scure/bip39": "^2.4.0",
    "chart.js": "4.6.1",
    "compression": "^1.8.2",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "express": "^5.3.0",
    "http-proxy-middleware": "^4.2.2",
    "i18next": "^26.7.2",
    "i18next-browser-languagedetector": "^8.3.0",
    "lucide-react": "^0.575.0",
    "nostr-tools": "2.25.1",
    "qr-scanner": "^1.4.2",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.13",
    "react-markdown": "10.1.0",
    "react-router": "^8.5.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/browser-playwright": "4.1.12",
    "autoprefixer": "^10.6.2",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7.13.0",
    "playwright": "1.64.1",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^6.4.6",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "4.1.12"
  }
}
