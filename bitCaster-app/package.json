{
  "name": "bitcaster",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint:enum-discipline": "bash scripts/check-enum-discipline.sh",
    "lint:identity-ops": "bash scripts/check-identity-ops-boundary.sh",
    "lint:wallet-ops": "bash scripts/check-wallet-ops-boundary.sh",
    "test": "vitest run",
    "test:nut16-browser": "vitest run --config vitest.browser.config.ts",
    "test:watch": "vitest",
    "generate:api": "openapi-typescript ../BitCaster.MatchingEngine.Contracts/specs/openapi.yaml -o src/generated/api.ts"
  },
  "dependencies": {
    "@cashu/cashu-ts": "file:../cashu-ts",
    "@microsoft/signalr": "^10.0.11",
    "@noble/curves": "^2.2.0",
    "@nostr-dev-kit/ndk": "^3.0.3",
    "@nostr-dev-kit/ndk-wallet": "^0.7.1",
    "@scure/bip39": "^2.3.0",
    "compression": "^1.8.1",
    "dexie": "^4.4.5",
    "dexie-react-hooks": "^4.4.0",
    "express": "^4.21.0",
    "http-proxy-middleware": "^4.2.0",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^0.575.0",
    "nostr-tools": "^2.24.2",
    "qr-scanner": "^1.4.2",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "react-router": "^8.3.0",
    "uplot": "^1.6.32",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/browser-playwright": "^4.1.8",
    "autoprefixer": "^10.5.4",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.0.18"
  }
}
