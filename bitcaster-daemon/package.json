{
  "name": "@bitcaster-market/daemon",
  "version": "0.1.0",
  "type": "module",
  "description": "Long-running wallet and atomic swap daemon for bitCaster markets",
  "engines": {
    "node": ">=22.15"
  },
  "bin": {
    "bitcaster-daemon": "dist/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "import": "./dist/main.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js"
    },
    "./rpcAuth": {
      "types": "./dist/rpcAuth.d.ts",
      "import": "./dist/rpcAuth.js"
    },
    "./dataDir": {
      "types": "./dist/dataDir.d.ts",
      "import": "./dist/dataDir.js"
    },
    "./nativeConfig": {
      "types": "./dist/nativeConfig.d.ts",
      "import": "./dist/nativeConfig.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "prebuild": "npm run build --workspace @bitcaster-market/client-sdk && npm run build --workspace @bitcaster-market/swap-protocol",
    "build": "tsc -p tsconfig.build.json",
    "postbuild": "node ../scripts/rewrite-dts-imports.mjs dist",
    "prepack": "npm run build",
    "test": "node --experimental-strip-types --import ./test/dataDirTestSetup.ts --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bitcaster-market/client-sdk": "0.1.0",
    "@bitcaster-market/swap-protocol": "0.1.0",
    "@cashu/cashu-ts": "file:../cashu-ts",
    "@microsoft/signalr": "^10.0.0",
    "nostr-tools": "^2.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.7.2"
  }
}
