{
  "name": "@bitcaster-market/daemon",
  "version": "0.1.0",
  "type": "module",
  "description": "Long-running Cashu wallet daemon for bitCaster markets",
  "engines": {
    "node": ">=22.15"
  },
  "bin": {
    "bitcaster-daemon": "dist/main.js"
  },
  "exports": {
    "./nativeBookmarks": {
      "types": "./dist/nativeBookmarks.d.ts",
      "import": "./dist/nativeBookmarks.js"
    },
    "./nativeSignerProfile": {
      "types": "./dist/nativeSignerProfile.d.ts",
      "import": "./dist/nativeSignerProfile.js"
    },
    "./nativeSettings": {
      "types": "./dist/nativeSettings.d.ts",
      "import": "./dist/nativeSettings.js"
    },
    ".": {
      "types": "./dist/main.d.ts",
      "import": "./dist/main.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js"
    },
    "./rpcAuth": {
      "types": "./dist/rpcAuth.d.ts",
      "import": "./dist/rpcAuth.js"
    },
    "./dataDir": {
      "types": "./dist/dataDir.d.ts",
      "import": "./dist/dataDir.js"
    },
    "./nativeConfig": {
      "types": "./dist/nativeConfig.d.ts",
      "import": "./dist/nativeConfig.js"
    },
    "./secrets": {
      "types": "./dist/secrets.d.ts",
      "import": "./dist/secrets.js"
    }
  },
  "files": [
    "dist",
    "native"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "prebuild": "npm run build --workspace @bitcaster-market/client-sdk",
    "build": "tsc -p tsconfig.build.json",
    "build:native-oracle-helper": "node ../scripts/build-native-oracle-helper.mjs",
    "postbuild": "node ../scripts/rewrite-dts-imports.mjs dist",
    "prepack": "npm run build && npm run build:native-oracle-helper",
    "test": "node --experimental-strip-types --import ./test/dataDirTestSetup.ts --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bitcaster-market/client-sdk": "0.1.0",
    "@cashu/cashu-ts": "file:../cashu-ts",
    "@microsoft/signalr": "^10.0.0",
    "nostr-tools": "^2.23.8",
    "ws": "8.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/ws": "8.18.1",
    "typescript": "^5.7.2"
  }
}
