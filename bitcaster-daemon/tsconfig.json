{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@cashu/cashu-ts": ["../cashu-ts/lib/types/index.d.ts"],
      "@bitcaster-market/client-sdk": ["../bitcaster-client-sdk/src/index.ts"],
      "@bitcaster-market/client-sdk/*": ["../bitcaster-client-sdk/src/*"]
    }
  },
  "include": ["src"]
}
