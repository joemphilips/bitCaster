{
  "name": "bitcaster-monorepo",
  "private": true,
  "scripts": {
    "format": "prettier --write \"{bitCaster-app,bitCaster-doc,bitcaster-cli,bitcaster-client-sdk,bitcaster-daemon,scripts,test-vectors,tools}/**/*.{js,mjs,cjs,ts,tsx,css,json}\" \"*.{js,mjs,cjs,ts,tsx,json}\"",
    "format:check": "prettier --check \"{bitCaster-app,bitCaster-doc,bitcaster-cli,bitcaster-client-sdk,bitcaster-daemon,scripts,test-vectors,tools}/**/*.{js,mjs,cjs,ts,tsx,css,json}\" \"*.{js,mjs,cjs,ts,tsx,json}\"",
    "test:mutation:sdk:baseline": "node --experimental-strip-types --test bitcaster-client-sdk/test/marketUnits.test.ts",
    "test:mutation:sdk": "stryker run stryker.sdk.config.mjs",
    "test:mutation:app:baseline": "npm --workspace bitCaster-app run test -- --run src/lib/__tests__/formatAmount.test.ts",
    "test:mutation:app": "stryker run stryker.app.config.mjs",
    "test:mutation:daemon:baseline": "node --experimental-strip-types --import ./bitcaster-daemon/test/dataDirTestSetup.ts --test --test-name-pattern=\"strict native config rejects malformed\" bitcaster-daemon/test/nativeConfig.test.ts",
    "test:mutation:daemon": "stryker run stryker.daemon.config.mjs",
    "test:mutation:cli:baseline": "node --experimental-strip-types --import ./bitcaster-daemon/test/dataDirTestSetup.ts --test --test-name-pattern=\"config list does not rewrite already sanitized config\" bitcaster-cli/test/cli.test.ts",
    "test:mutation:cli": "stryker run stryker.cli.config.mjs",
    "vectors:nut-ctf-range:generate": "node scripts/generate-nut-ctf-range-v1.mjs --write",
    "vectors:nut-ctf-range:check": "node scripts/generate-nut-ctf-range-v1.mjs --check",
    "postinstall": "node scripts/postinstall-build-cli.mjs"
  },
  "workspaces": [
    "bitCaster-app",
    "bitcaster-client-sdk",
    "bitcaster-daemon",
    "bitcaster-cli",
    "cashu-ts"
  ],
  "devDependencies": {
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.3"
  }
}
