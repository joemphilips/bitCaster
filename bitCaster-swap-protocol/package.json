{
  "name": "@bitcaster-market/swap-protocol",
  "version": "0.1.0",
  "type": "module",
  "description": "Atomic swap protocol primitives for bitCaster markets",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "postbuild": "node ../scripts/rewrite-dts-imports.mjs dist",
    "prepack": "npm run build",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    "./atomicSwap": {
      "types": "./dist/atomicSwap.d.ts",
      "import": "./dist/atomicSwap.js"
    },
    "./ecdh": {
      "types": "./dist/ecdh.d.ts",
      "import": "./dist/ecdh.js"
    },
    "./adaptor": {
      "types": "./dist/adaptor.d.ts",
      "import": "./dist/adaptor.js"
    },
    "./p2pk": {
      "types": "./dist/p2pk.d.ts",
      "import": "./dist/p2pk.js"
    },
    "./url": {
      "types": "./dist/url.d.ts",
      "import": "./dist/url.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@cashu/cashu-ts": "npm:@bitcaster-market/cashu-ts@4.5.0-bitcaster.0",
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "typescript": "^5.7.2"
  }
}
