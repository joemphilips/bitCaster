{
  "name": "@bitcaster-market/client-sdk",
  "version": "0.1.0",
  "type": "module",
  "description": "Shared TypeScript client and trading helpers for bitCaster markets",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ctfSplit": {
      "types": "./dist/ctfSplit.d.ts",
      "import": "./dist/ctfSplit.js"
    },
    "./ctfConsolidation": {
      "types": "./dist/ctfConsolidation.d.ts",
      "import": "./dist/ctfConsolidation.js"
    },
    "./engineClient": {
      "types": "./dist/engineClient.d.ts",
      "import": "./dist/engineClient.js"
    },
    "./orderValidation": {
      "types": "./dist/orderValidation.d.ts",
      "import": "./dist/orderValidation.js"
    },
    "./outcomeSets": {
      "types": "./dist/outcomeSets.d.ts",
      "import": "./dist/outcomeSets.js"
    },
    "./proofSelection": {
      "types": "./dist/proofSelection.d.ts",
      "import": "./dist/proofSelection.js"
    },
    "./settlementSupport": {
      "types": "./dist/settlementSupport.d.ts",
      "import": "./dist/settlementSupport.js"
    },
    "./swapFailure": {
      "types": "./dist/swapFailure.d.ts",
      "import": "./dist/swapFailure.js"
    },
    "./tradeFlow": {
      "types": "./dist/tradeFlow.d.ts",
      "import": "./dist/tradeFlow.js"
    },
    "./tradeSession": {
      "types": "./dist/tradeSession.d.ts",
      "import": "./dist/tradeSession.js"
    },
    "./tradeTicket": {
      "types": "./dist/tradeTicket.d.ts",
      "import": "./dist/tradeTicket.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "postbuild": "node ../scripts/rewrite-dts-imports.mjs dist",
    "prepack": "npm run build",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@cashu/cashu-ts": "file:../cashu-ts"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
