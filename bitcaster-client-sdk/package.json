    "./swapFailure": {
      "types": "./dist/swapFailure.d.ts",
      "import": "./dist/swapFailure.js"
    },
    "./tradeFlow": {
      "types": "./dist/tradeFlow.d.ts",
      "import": "./dist/tradeFlow.js"
    },
    "./tradeIgnition": {
      "types": "./dist/tradeIgnition.d.ts",
      "import": "./dist/tradeIgnition.js"
    },
    "./tradePreparation": {
      "types": "./dist/tradePreparation.d.ts",
      "import": "./dist/tradePreparation.js"
    },
    "./tradeSession": {
      "types": "./dist/tradeSession.d.ts",
      "import": "./dist/tradeSession.js"
    },
    "./tradeTicket": {
      "types": "./dist/tradeTicket.d.ts",
      "import": "./dist/tradeTicket.js"
    },
    "./tradingClient": "./src/tradingClient.ts",
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "postbuild": "node ../scripts/rewrite-dts-imports.mjs dist",
    "prepack": "npm run build",
    "pretest": "npm run build",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "@cashu/cashu-ts": "file:../cashu-ts"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
