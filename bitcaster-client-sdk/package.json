  "version": "0.1.0",
  "type": "module",
  "description": "Shared TypeScript client and trading helpers for bitCaster markets",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ctfSplit": {
      "types": "./dist/ctfSplit.d.ts",
      "import": "./dist/ctfSplit.js"
    },
    "./ctfConsolidation": {
      "types": "./dist/ctfConsolidation.d.ts",
      "import": "./dist/ctfConsolidation.js"
    },
    "./durableCustody": {
      "types": "./dist/durableCustody.d.ts",
      "import": "./dist/durableCustody.js"
    },
    "./durableCustodyProofOperation": {
      "types": "./dist/durableCustodyProofOperation.d.ts",
      "import": "./dist/durableCustodyProofOperation.js"
    },
    "./durableCustodyProofOperationRecord": {
      "types": "./dist/durableCustodyProofOperationRecord.d.ts",
      "import": "./dist/durableCustodyProofOperationRecord.js"
    },
    "./durableWalletOperation": {
      "types": "./dist/durableWalletOperation.d.ts",
      "import": "./dist/durableWalletOperation.js"
    },
    "./durableWalletProofTransition": {
      "types": "./dist/durableWalletProofTransition.d.ts",
      "import": "./dist/durableWalletProofTransition.js"
