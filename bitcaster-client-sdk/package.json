    "./proofSelection": {
      "types": "./dist/proofSelection.d.ts",
      "import": "./dist/proofSelection.js"
    },
    "./proofUnit": {
      "types": "./dist/proofUnit.d.ts",
      "import": "./dist/proofUnit.js"
    },
    "./tokenImportValidation": {
      "types": "./dist/tokenImportValidation.d.ts",
      "import": "./dist/tokenImportValidation.js"
    },
    "./participationScore": {
      "types": "./dist/participationScore.d.ts",
      "import": "./dist/participationScore.js"
    },
    "./settlementSupport": {
      "types": "./dist/settlementSupport.d.ts",
      "import": "./dist/settlementSupport.js"
